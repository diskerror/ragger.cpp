# build_info.cmake — run at BUILD time (cmake -P) to write build_info.cpp.
#
# Inputs: -DSRC_DIR=<repo> -DOUT=<file> -DVERSION=<project version>
# The file is rewritten only when version/commit/dirty state change, so a
# new commit or tag recompiles this one file and relinks — no reconfigure,
# no full rebuild. RAGGER_BUILD_DATE is the time the info last changed.
execute_process(COMMAND git rev-parse --short=7 HEAD
    WORKING_DIRECTORY "${SRC_DIR}" OUTPUT_VARIABLE COMMIT
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    set(COMMIT "unknown")
else()
    execute_process(COMMAND git status --porcelain --untracked-files=no
        WORKING_DIRECTORY "${SRC_DIR}" OUTPUT_VARIABLE DIRTY
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(DIRTY)
        string(APPEND COMMIT "-dirty")
    endif()
endif()

set(KEY "${VERSION}|${COMMIT}")
set(STAMP "${OUT}.key")
if(EXISTS "${OUT}" AND EXISTS "${STAMP}")
    file(READ "${STAMP}" OLD)
    if(OLD STREQUAL KEY)
        return()
    endif()
endif()

string(TIMESTAMP DATE "%Y-%m-%d %H:%M:%S")
file(WRITE "${OUT}" "// Generated by cmake/build_info.cmake — do not edit.
#include \"build_info.h\"
namespace ragger::build {
const char* version() { return \"${VERSION}\"; }
const char* commit()  { return \"${COMMIT}\"; }
const char* date()    { return \"${DATE}\"; }
}
")
file(WRITE "${STAMP}" "${KEY}")
